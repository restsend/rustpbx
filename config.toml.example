# A example config file
# mv config.toml.example config.toml
# cargo run . --bin rustpbx --conf config.toml

http_addr = "0.0.0.0:8080"
# http_gzip = true
log_level = "debug"
#log_file = "/tmp/rustpbx.log"
# Local stats log (one JSON line per stats_interval seconds, system+PBX summary
# for loss/load diagnostics without Prometheus). Empty/unset disables.
#stats_log = "/var/log/rustpbx.stats.log"
#stats_interval = 5
# Paths can include a trailing * to skip whole subtrees
# http_access_skip_paths = ["/health", "/metrics*"]
# SQLite database (default)
database_url = "sqlite://rustpbx.sqlite3"
# MySQL / PostgreSQL database example:
# database_url = "postgres://user:pass@localhost/rustpbx"

# Database connection pool settings (applies to PostgreSQL/MySQL)
# When not configured, max_connections defaults to 64.
# [database_pool]
# max_connections = 64
# min_connections = 0
# acquire_timeout_secs = 30
# idle_timeout_secs = 600
# max_lifetime_secs = 1800

# external IP address for SIP signaling and media
# if server is behind NAT, set your public IP here (without port)
# external_ip = "1.2.3.4"

# Auto-detect external IP via HTTP service (mutually exclusive with external_ip)
# At startup, a GET request is sent to this URL and the response body is parsed as IP
# Leave empty to use the default: http://ifconfig.me
# auto_external_ip = "http://ifconfig.me"

# rtp_start_port = 20000
# rtp_end_port = 30000

# Max size in bytes for audio files downloaded over HTTP from the console
# (queue prompts, voicemail prompts, ...). Default: 20971520 (20 MB)
# max_audio_download_bytes = 20971520

# setup your STUN/TURN servers here, for webrtc web clients
# [[ice_servers]]
# urls = ["stun:stun.l.google.com:19302"]

# [[ice_servers]]
# urls = ["turn:restsend.com:3478"]
# username = "user"
# credential = "pass"

# Shared SIP and HTTP AMI cluster peers.
# [cluster]
# peers = [{ addr = "10.0.0.2", sip_port = 5060, ami_port = 8080 }]

[console]
#session_secret = "please_change_me_to_a_random_secret"
base_path = "/console"
# API prefix for REST endpoints (default: "/api")
# All REST API endpoints will be prefixed with this path
api_prefix = "/api"
# allow self-service administrator signup after the first account
allow_registration = false
# set to true to force Secure cookie attribute, otherwise it is auto-detected based on request
secure_cookie = false
# Static files HTTP path prefix (default: "/static")
static_path = "/static"

[ami]
# AMI access allow list. Supports exact IPs, CIDR ranges, and "*".
# Defaults to localhost only when omitted.
allows = ["127.0.0.1", "::1", "10.0.0.0/8"]

[proxy]
modules = ["acl", "auth", "presence", "registrar", "call"]
addr = "0.0.0.0"
udp_port = 15060
registrar_expires = 60
ws_handler= "/ws"
ami_path = "/ami/v1"
ice_servers_path = "/iceservers"
media_proxy = "auto"

# Direct extension-to-extension (P2P) calls: when a callee has multiple
# registered devices, ring ALL of them in parallel (first to answer wins).
# Set to false to ring only the most recently registered device instead.
# Default: true
# parallel_fork = true

# Global default max ring/setup time (seconds) before a no-answer call is
# rejected with 408. 0 or unset disables the ring timeout (the call rings
# until answered or the caller cancels). Per-trunk / per-route max_ring_time
# overrides this. Hot-reloadable (new calls only).
# max_ring_time = 60

# Worker thread isolation: SIP signalling and RTP media run on separate tokio
# runtimes, preventing heavy media-plane load from starving SIP timer tasks.
# Defaults: sip_worker_threads = min(4, num_cpus), media_worker_threads = rest.
# sip_worker_threads = 4
# media_worker_threads = 28

# RFC 4028 session timer: ON by default (Supported mode) so a silently
# disconnected peer (e.g. WebRTC over WS closed without BYE) is detected via
# the refresh/expiry cycle instead of leaking the session forever. Set
# session_timer = false to disable, or session_timer_always = true to keep
# refreshing even if the peer does not negotiate the session timer.
# session_timer = true
# session_timer_always = false
# Default refresh/expiry interval in seconds when the peer sends no
# Session-Expires of its own (default 600).
# session_expires = 600

# Default hold music played to the held party when an agent puts a call on
# hold. Resolution order: explicit hold command -> per-call X-Hold-Music SIP
# header -> skill-group metadata.hold_music (CC addon) -> this setting ->
# built-in default (sounds/phone-calling.wav). Accepts a file path under
# config/sounds (e.g. "sounds/phone-calling.wav") or an http(s) URL.
# Hot-reloadable. Note: queue wait music while callers wait in a dialplan
# queue is configured separately per queue ([queue.hold] in config/queue/*.toml).
# hold_music = "sounds/phone-calling.wav"

# Blind transfer signalling mode. false (default) = B2BUA: the PBX dials the
# transfer target as a new B leg and stays in the media path. true = send a
# SIP REFER to the transferee (true blind transfer, media released to the
# endpoints). If the peer rejects the REFER with 405/420/501 (not supported),
# the PBX automatically falls back to the B2BUA path. Transfers issued with
# wait_for_result=true always use B2BUA. Hot-reloadable.
# blind_transfer_use_refer = false
# Base directory for generated routing/trunk/ACL files
generated_dir = "./config"
routes_files = ["config/routes/*.toml"]
trunks_files = ["config/trunks/*.toml"]
addons = ["acme", "wholesale"]

# Step IVR session recovery when the external provider cannot continue.
# Match rules use the same from/to/header.* semantics as dialplan routes.
# First matching rule (priority desc) wins; otherwise `default` is used.
# [proxy.ivr_fallback]
# default = "default"
# [[proxy.ivr_fallback.rules]]
# name = "vip"
# priority = 100
# match = { "from.user" = "^9" }
# target = "builtin_vip_step"
# Don't responed the request when user not existed (slience for spam scanner)
ensure_user = true

# ACL rules
acl_rules = [
    # "allow 10.0.0.0/8",
    # "deny 0.123.4.0/16",
    "allow all",
    "deny all"
]
acl_files = ["config/acl/*.toml"]

[[proxy.user_backends]]
type = "memory"
users = [
    { username = "bob", password = "123456" },
    { username = "alice", password = "123456" },
]

[[proxy.user_backends]]
type = "extension"

# JWT Fast Registration — skip 401/407 Digest challenge for JWT-authenticated clients.
# Required for CC Agent-ID (cc-phone JWT) login mode. See docs/cc_agent_login_modes.md.
# See docs/config/03-auth-users.md for full documentation.
# [proxy.jwt_auth]
# enabled = true
# secret = "your-shared-hs256-secret"
# user_id_claim = "userId"
# check_local_user = false
# Enable dev-console JWT/PhoneAuth token mint endpoints (POST /api/cc/dev/*).
# Defaults to false — production should keep this off.
# dev_mint_enabled = true

# HTTP Token Auth Backend — one-shot token auth via external HTTP service.
# Add token_header to any HTTP user backend to enable one-shot registration.
# See docs/config/03-auth-users.md for full documentation.
# [[proxy.user_backends]]
# type = "http"
# url = "https://auth-service.example.com/sip-auth"
# method = "POST"
# sip_headers = ["X-Auth-Token"]     # Forward token to external service
# token_header = "X-Auth-Token"      # Enable one-shot token auth (skip 407)
# http_timeout_ms = 5000             # Default: 5000
# http_retry_count = 1              # Default: 1 (retries on network error + 5xx)
# http_retry_delay_ms = 500         # Default: 500
# token_cache_ttl_secs = 60         # Default: 0 (disabled). Recommended: 30-300
# token_cache_size = 10000          # Default: 10000 (LRU eviction)

# Audio codec allowlist (e.g. PCMU, PCMA, G722, OPUS).
# audio_codecs = ["pcma","pcmu","g722","opus"]

# Video codec allowlist for pass-through relay. Only codecs present in the
# peer's SDP are retained; this setting does not create a video section.
# H264 and VP8 are enabled by default and are the only supported values.
# video_codecs = ["H264", "VP8"]

# Media-plane video relay policy for proxied calls:
#   - "pass_through" (default when unset): relay video between legs when both
#     sides negotiate a common configured codec. No transcoding.
#   - "strip": drop video from the media path entirely (audio-only).
#   - "transcode": same as pass_through for now (video transcoding not yet
#     implemented); reserved for future H264↔VP8 conversion.
# Set per-trunk via trunk.video_policy, or globally here.
# video_policy = "pass_through"

# ── Recording ─────────────────────────────────────────────────────────────────
# [recording].enabled is the master switch for whether media is recorded.
# `type` selects WHERE media is captured:
#   "local" | "http" | "s3"  → WAV file recorder + [recording] upload
#   "sipflow"                → SipflowRecorder into the [sipflow] backend
#                              (upload via [sipflow.upload].media)
#
# SIP signalling is captured whenever [sipflow] is configured (independent of
# type). Without [sipflow], there is no SIP ladder / signalling upload.
#
# auto_start installs the selected recorder automatically. auto_start_at
# controls whether that happens at the first completed caller-media setup
# ("media", default) or only after caller media is ready for the final answer.
#
# Recommended patterns:
#   • WAV + sipflow signalling:
#       [recording] enabled=true type="local" (or http/s3)
#       [sipflow] + [sipflow.upload] signaling=true media=false
#   • Full sipflow (RTP + SIP):
#       [recording] enabled=true type="sipflow"
#       [sipflow] + [sipflow.upload] media=true signaling=true
#
[recording]
enabled = true
auto_start = true
auto_start_at = "media" # default; use "answer" to wait for 200
# Media destination: "local" (default), "http", "s3", or "sipflow".
# type = "local"
# path = "./config/recorders"  # default when omitted or blank (file types only)
#
# Mid-call / IVR segmented recording: set auto_start = false so the call does
# not record by default; IVR `record_start`/`record_stop` (or RWI
# record.start/stop) open slices named
# {session_id}_{YYYYMMDDHHMMSS}_{type}_{id}.wav. CDR metadata.recording_segments
# lists every slice. Prefer record_stop before transfer/REFER.
#
# On upload failure a sibling
# .upload_failed.{filename} JSON marker is written (time/address/duration_ms/error);
# local files are deleted only after a successful remote upload.
#
# type = "local" archival layout under path:
# subdir = "daily"   # default — {path}/YYYYMMDD/{file}
# # subdir = "hourly"  # {path}/YYYYMMDD/HH/{file}

# ── Live transcription (streaming ASR) ───────────────────────────────────────
# Real-time call transcription over a streaming ASR WebSocket. When configured,
# `GET /cc/calls/{call_id}/transcript` (SSE) lazily starts transcription on
# first subscribe and streams text segments; cc-phone shows a live transcript
# panel. Without this section the feature reports unavailable (503) and the
# cc-phone transcript button is grayed out.
#
# The wire protocol is Deepgram-compatible raw PCM streaming
# (`/v1/listen?encoding=linear16&sample_rate=16000`); any endpoint speaking
# the same envelope works.
#
# [proxy.transcript.remote]
# # API key (falls back to the DEEPGRAM_API_KEY env var)
# # api_key = "your-key"
# # Override endpoint (default wss://api.deepgram.com)
# # url = "wss://api.deepgram.com"
# # model = "nova-2"
# # language = "multi"        # BCP-47 tag, or "multi"
# # interim_results = true    # stream partial hypotheses
# # punctuate = true

# ── CDR (Call Detail Records) ─────────────────────────────────────────────────
# Call records are persisted to the `rustpbx_call_records` table in the primary
# database by default, even without any [callrecord] section.
#
# [callrecord] is OPTIONAL — it overrides the default storage, lets you route
# CDRs to an external database or file sink, and can disable the built-in table.
#
# Storage types:
#   type = "database" — write full CDR schema to a configurable database/table
#                       (DEFAULT when no [callrecord] section is present)
#   type = "local"    — write CDR JSON files to a local directory
#   type = "s3"       — upload CDR JSON to S3-compatible object storage
#   type = "http"     — POST CDR JSON to an HTTP webhook endpoint
#
# When type = "database":
#   - database_url     = None → use the main database (default)
#   - table_name       = "rustpbx_call_records" (default)
#   - skip_create_table = false    → true = assume table exists (skip DDL)
#   - rotate           = "none"    → "daily" for SQLite daily files
#
#   rotate = "daily" with SQLite:
#     The database_url path gets the date inserted before the extension,
#     producing daily files: cdr.db → cdr-20260722.db, cdr-20260723.db, ...
#     The Web Console CDR page queries today's file (or a specified date).
#
# IMPORTANT: When a non-default database/table/rotate config is used, the
# Web Console and addon CDR queries (cc, wholesale, archive) may not see
# the data — they query the primary `rustpbx_call_records` table. This is
# an accepted trade-off for external / rotated CDR storage.
#
# [callrecord]
# type = "database"
# table_name = "rustpbx_call_records"
# max_concurrent = 64
#
# External PostgreSQL:
# [callrecord]
# type = "database"
# database_url = "postgres://user:pass@cdrhost/cdrs"
# table_name = "my_cdrs"
# skip_create_table = true
#
# SQLite daily rotation:
# [callrecord]
# type = "database"
# database_url = "sqlite:///var/lib/cdr/cdr.db"
# table_name = "rustpbx_call_records"
# rotate = "daily"
#
# File sink (no CDB query support):
# [callrecord]
# type = "local"
# root = "./config/cdr"

# ── SipFlow ───────────────────────────────────────────────────────────────────
# [sipflow] enables SIP signalling capture for every call (MessageInspector).
# RTP capture additionally requires:
#   [recording] enabled = true AND type = "sipflow"
# When type is local/http/s3, SipFlow stores SIP only; WAV media is owned by
# [recording] and [sipflow.upload].media is skipped automatically.
#
# Console shows the SIP flow ladder from the backend; audio player works when
# RTP was stored (type=sipflow) or when a WAV was uploaded via [recording].
[sipflow]
type = "local"
root = "./config/sipflow"
subdirs = "daily"  # "none" | "daily" | "hourly"  (sqlite engine only)

# Storage engine: "flowdb" (default, LSM-tree) or "sqlite" (legacy)
engine = "flowdb"

# FlowDB engine options (ignored when engine = "sqlite"):
# ttl_secs = 86400          # auto-expire records after N seconds (optional)
# memtable_size_mb = 64     # memtable size threshold before flush
# block_cache_capacity_mb = 128  # LRU block cache for reads

# Advanced local backend settings (sqlite engine only, defaults shown):
# flush_count = 1000
# flush_interval_secs = 5
# id_cache_size = 8192

# Optional: upload after each call.
# [sipflow.upload]
# type = "s3"
# vendor = "aws"
# bucket = "my-recordings"
# region = "us-east-1"
# access_key = "AKID"
# secret_key = "SECRET"
# endpoint = "https://s3.amazonaws.com"
# root = "recordings"
# media = true          # upload RTP as WAV when type=sipflow (default: true)
# signaling = true      # upload SIP signalling JSONL (recommended with [sipflow])

# Remote backend (single node):
# [sipflow]
# type = "remote"
# udp_addr = "192.168.1.100:3000"
# http_addr = "http://192.168.1.100:3001"
# timeout_secs = 10
# mtu = 1500  # Maximum IP packet size; set to 0 to disable UDP batch splitting

# Remote cluster (multi-node, consistent hashing by call_id):
# [sipflow]
# type = "remote"
# timeout_secs = 10
# mtu = 1500  # Maximum IP packet size; set to 0 to disable UDP batch splitting
# nodes = [
#     { udp = "192.168.1.1:3000", http = "http://192.168.1.1:3001" },
#     { udp = "192.168.1.2:3000", http = "http://192.168.1.2:3001" },
#     { udp = "192.168.1.3:3000", http = "http://192.168.1.3:3001" },
#     { udp = "192.168.1.4:3000", http = "http://192.168.1.4:3001" },
# ]

# [proxy.trunks.wuhoo]
# dest = "sip:123.456.789.00:1234"
# # Forward original custom headers to this trunk's outgoing INVITE.
# # Unset (default) -> forward nothing; internal destinations forward everything.
# # header_passthrough = { mode = "all" }
# # header_passthrough = { mode = "whitelist", whitelist = ["X-Smart2Agent", "X-SmartParams"] }
# # header_passthrough = { mode = "blacklist", blacklist = ["X-Token"] }

# Per-trunk ringback / early-media tones. Each value is an audio file path or a
# `tone://frequency,duration_ms` spec rendered into a WAV.
#
#   ring      — 彩铃/回铃音,played as 183 early media while the callee rings
#   busy      — 忙音,played as 183 early media before sending 486
#   reject    — 拒接音,played as 183 early media before sending 603
#   offline   — 不在线音,played as 183 early media before sending 480
#   notfound  — 空号音,played as 183 early media before sending 404
#   noanswer  — 无人应答音,played as 183 early media before the ring-timeout (408)
#   error     — 服务不可用音,played as 183 early media before a 5xx rejection
#               (e.g. an IVR/app fails to start because its config is missing
#               or invalid). Defaults to sounds/service_unavailable_en.mp3.
#
# Failure tones play ONCE to natural completion and then the call is rejected:
#   * audio files → the file plays to its full length (e.g. the English
#     sounds/service_unavailable_en.mp3 announcement plays entirely)
#   * tone://freq,ms → the tone plays for the specified ms (a 1-second minimum
#     is enforced so a short spec never sounds like an instant click)
# There is no fixed-length timer to tune.
#
# [proxy.trunks.wuhoo.ringback]
# ring = "/sounds/company_ringback.wav"
# busy = "tone://480,3000"
# noanswer = "tone://480,3000"

# Global failure-tone profile ([proxy.audio_profile]). Applied to EVERY call as
# the base audio profile; a per-trunk `ringback` overrides individual fields.
# When the table is unset, built-in defaults are used:
# busy/offline/noanswer/notfound/reject → `tone://` beeps, and 5xx (IVR/app
# start failures) → sounds/service_unavailable_en.mp3.
# Declare the table but leave it empty to disable all built-in failure audio;
# rejection responses are then sent without a RustPBX-generated 183 or tone.
#
# [proxy.audio_profile]
# error = "sounds/service_unavailable_en.mp3"
# busy = "tone://480,3000"

# Max ring/setup time in seconds for calls on this trunk before a no-answer
# rejection (408). Defaults to 60s.
# max_ring_time = 60

# [[proxy.routes]]
# name = "default"
# priority = 1
# dest = "wuhoo"

# [proxy.routes.match]
# "to.user" = "^\\+.*"

# [proxy.routes.rewrite]
# "to.user" = "+{1}"
# "to.host" = "123.456.789.00:1234"
# "from.user" = "12345"
# "from.host" = "123.456.789.00:1234"

# ── Commercial Addon Licenses ─────────────────────────────────────────────────
# Map each commercial addon to a named license key, then supply the actual key
# values under [licenses.keys].  The UI's "Verify" button on the Addon detail
# page will write these sections automatically.
#
# [licenses]
# [licenses.addons]
# wholesale         = "enterprise"   # addon id -> key name
# endpoint-manager  = "enterprise"
# voicemail         = "basic"
#
# [licenses.keys]
# enterprise = "LICENSE-KEY-XXXX-XXXX-XXXX"
# basic      = "LICENSE-KEY-YYYY-YYYY-YYYY"
